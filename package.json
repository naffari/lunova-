{
  "name": "lunova-services-website",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "node scripts/generate-sitemap.mjs && vite build && vite build --ssr src/entry-server.tsx && node scripts/prerender.mjs",
    "build:client": "vite build",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "check:prices": "node scripts/check-prices.mjs",
    "images": "node scripts/optimize-images.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.6",
    "clsx": "2.1.1",
    "lucide-react": "0.487.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-helmet-async": "^3.0.0",
    "react-router": "7.13.0",
    "resend": "^4.0.1",
    "tailwind-merge": "3.2.0",
    "tw-animate-css": "1.3.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.12",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vercel/node": "^3.2.29",
    "@vitejs/plugin-react": "4.7.0",
    "sharp": "^0.35.3",
    "tailwindcss": "4.1.12",
    "typescript": "^5.9.3",
    "vite": "6.3.5"
  },
  "pnpm": {
    "overrides": {
      "vite": "6.3.5"
    }
  }
}