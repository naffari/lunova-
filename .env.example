# Resend API key used by api/booking.ts to send booking-request emails.
# Get one from https://resend.com after verifying the lunovaservices.com
# sending domain. Set this in your Vercel project's Environment Variables
# (Settings -> Environment Variables) — do not commit a real key.
RESEND_API_KEY=

# Server-side key for the Lunova CRM public API (crm.lunovaservices.com).
# Generated on the CRM side; pull it with `vercel env pull .env.local` from the
# lunova-crm project, or copy it from the Vercel dashboard. NEVER expose this to
# the browser — it grants full lead-intake access. Set it in this website's
# Vercel project (Production, Preview, Development).
WEBSITE_API_KEY=

# Optional CRM base URL override. Defaults to https://crm.lunovaservices.com.
CRM_API_URL=
